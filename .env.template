# Conductor — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.template .env

# === Required ===

# PostgreSQL connection string
# Local dev: postgresql://conductor:localdev@localhost:5432/conductor
# Docker:    postgresql://conductor:localdev@localhost:5433/conductor (mapped port)
DATABASE_URL=postgresql://conductor:localdev@localhost:5432/conductor

# NextAuth session secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# NextAuth base URL
NEXTAUTH_URL=http://localhost:3000

# Anthropic API key — get from https://console.anthropic.com
# Can also be set in-app via Settings > System > API Keys
ANTHROPIC_API_KEY=

# === Optional ===

# App password hash (bcrypt) — set automatically during onboarding
# Only needed if pre-configuring outside the setup wizard
# APP_PASSWORD_HASH=

# File upload directory
UPLOAD_DIR=./uploads

# Postgres password — used by docker-compose.yml (default: localdev)
# POSTGRES_PASSWORD=localdev

# Granola API key — required for meeting transcript sync
# Get from Granola Settings > API (Business plan required)
# GRANOLA_API_KEY=

# Linear sync secret — shared secret for cron sync authentication
# LINEAR_SYNC_SECRET=conductor-linear-sync

# Timezone — IANA timezone for schedule block matching (default: America/New_York)
# TIMEZONE=America/New_York

# Local MLX server (OpenAI-compatible, e.g. mlx_lm.server) — used as fallback when
# cloud AI fails, and selectable for chat. Conductor runs its own server on 11436
# (com.conductor.mlx LaunchAgent). Port 11435 is the kosmos PRODUCTION server —
# do not point Conductor at it without reading docs/RUNBOOK_LOCAL_AI.md.
# LOCAL_AI_BASE_URL=http://host.docker.internal:11436/v1
# LOCAL_AI_MODEL=mlx-community/Qwen3-30B-A3B-Instruct-2507-4bit
# LOCAL_AI_MAX_TOKENS=2048

# Document handling — sized for the load-tested safe window of the local server
# (GPU watchdog kills requests past ~55K tokens of context; see RUNBOOK_LOCAL_AI.md)
# UPLOAD_EXTRACT_MAX_CHARS=120000   # extracted text kept per upload (~30K tokens)
# DOC_SUMMARY_MAX_CHARS=100000      # document text sent for background summarization
# LOCAL_AI_MAX_INPUT_CHARS=160000   # hard input guard in callLocal (~40K tokens)
# CLOUD_AI_MAX_TEXT_CHARS=60000     # per-segment cap for CLOUD models (cost guard)

# MCP server auth — bearer token for /api/mcp (external agents, e.g. Claude Code)
# Generate with: openssl rand -hex 32
# MCP_API_TOKEN=""

# Calendar prep tasks — "off" stops meetings from creating prep tasks (agenda strip unaffected)
# CALENDAR_PREP_TASKS="off"
